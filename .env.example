# Application
APP_NAME=document-verification-service
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Google Cloud Vision Authentication (Choose Option A or Option B)
# Option A: API Key string (easiest)
GOOGLE_VISION_API_KEY=AIzaSy...your-api-key-here

# Option B: Service Account JSON file path
# GOOGLE_APPLICATION_CREDENTIALS=credentials/google-service-account.json
# GOOGLE_CLOUD_PROJECT=your-project-id

# Storage & Archive Limits (in bytes and counts)
MAX_ZIP_SIZE=52428800           # 50 MB
MAX_EXTRACTED_SIZE=104857600    # 100 MB
MAX_FILES_PER_ZIP=50
TEMP_DIR=/tmp/driver_verification

# Network Timeouts (in seconds)
DOWNLOAD_TIMEOUT=30
VISION_TIMEOUT=30

# Batch & Concurrency Configuration
MAX_BATCH_SIZE=50
MAX_CONCURRENT_WORKERS=5

# Verification Match Thresholds
NAME_MATCH_THRESHOLD=95
NAME_FUZZY_REVIEW_THRESHOLD=85
